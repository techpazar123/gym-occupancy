# Sunucu portu (Railway/Render otomatik ayarlar)
PORT=3001

# PostgreSQL bağlantı URL'si
# Lokal: postgresql://kullanici:sifre@localhost:5432/gym_occupancy
# Railway: otomatik doldurulur
# Render: otomatik doldurulur
# Supabase: Settings > Database > Connection string (Transaction mode)
DATABASE_URL=postgresql://kullanici:sifre@host:5432/gym_occupancy

# JWT imzalama anahtarı — production'da güçlü rastgele bir değer kullan
JWT_SECRET=guclu-rastgele-anahtar-buraya

# Admin giriş bilgileri
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guclu-sifre-buraya

# Frontend URL'si (CORS için) — virgülle ayırarak birden fazla eklenebilir
# Örnek: https://gym.vercel.app
FRONTEND_URL=https://senin-frontend-urlin.vercel.app
